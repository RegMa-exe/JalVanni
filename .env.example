# Copy to .env and fill in. All values are read server-side only.
# Never prefix these with VITE_ (that would expose them to the browser bundle).

# Gnani AI — Prisma v3.0 speech-to-text (sent as the X-API-Key-ID header)
GNANI_API_KEY=your_gnani_api_key_here

# OpenRouter — LLM incident analysis
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Exact model id from https://openrouter.ai/models (the project was tested with qwen/qwen-2.5-72b-instruct)
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# Port for the production server (npm start). Optional; defaults to 8787.
PORT=8787
